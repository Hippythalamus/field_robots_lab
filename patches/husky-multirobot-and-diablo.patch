diff --git a/husky_description/urdf/selection_ring.urdf.xacro b/husky_description/urdf/selection_ring.urdf.xacro
new file mode 100644
index 0000000..f9625c4
--- /dev/null
+++ b/husky_description/urdf/selection_ring.urdf.xacro
@@ -0,0 +1,37 @@
+<?xml version="1.0"?>
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
+
+  <!--
+    Selection ring for the primary robot — Diablo-style HUD marker.
+
+    Attached to base_footprint so the ring sits exactly on ground level,
+    centred under the robot, regardless of base_link offset variations.
+
+    Uses a built-in Gazebo material name (Gazebo/Turquoise) for reliable
+    rendering — URDF rgba colours and custom emissives are unreliable
+    on mesh visuals in Gazebo Classic 11.
+
+    Visual only — no collision, no inertia.
+  -->
+  <xacro:macro name="selection_ring" params="prefix mesh_dir">
+    <link name="${prefix}selection_ring">
+      <visual>
+        <origin xyz="0 0 0.01" rpy="0 0 0"/>
+        <geometry>
+          <mesh filename="file://${mesh_dir}/selection_ring.stl"/>
+        </geometry>
+      </visual>
+    </link>
+
+    <gazebo reference="${prefix}selection_ring">
+      <material>Gazebo/Turquoise</material>
+    </gazebo>
+
+    <joint name="${prefix}selection_ring_joint" type="fixed">
+      <parent link="${prefix}base_footprint"/>
+      <child link="${prefix}selection_ring"/>
+      <origin xyz="0 0 0" rpy="0 0 0"/>
+    </joint>
+  </xacro:macro>
+
+</robot>
