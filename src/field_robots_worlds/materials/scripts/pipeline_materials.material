material PipelineWorlds/DirtGround
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient 0.7 0.7 0.7 1.0
      diffuse 0.9 0.9 0.9 1.0
      specular 0.1 0.1 0.1 1.0 12.5
      texture_unit
      {
        texture dirt_ground.jpg
        filtering trilinear
      }
    }
  }
}

