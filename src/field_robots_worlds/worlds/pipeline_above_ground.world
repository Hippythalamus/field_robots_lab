            <ambient>0.5 0.4 0.3 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main pipe 3 (smaller, upper level) -->
    <model name="pipe_main_3">
      <static>true</static>
      <pose>0 0 2.5 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>40</length>
            </cylinder>
