<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pipeline_above_ground">

    <!-- Physics -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Standard scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.4 -1.0</direction>
    </light>

    <!-- Ground plane (concrete-colored) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/scripts/pipeline_materials.material</uri>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/textures</uri>
              <name>PipelineWorlds/DirtGround</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- Pipeline section: 4 main horizontal pipes on supports          -->
    <!-- Layout: pipes run along X axis from x=-20 to x=20 (40m)        -->
    <!-- ============================================================== -->

    <!-- Main pipe 1 (lower, large diameter) -->
    <model name="pipe_main_1">
      <static>true</static>
      <pose>0 -2 1.5 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>40</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main pipe 2 -->
    <model name="pipe_main_2">
      <static>true</static>
      <pose>0 -1 1.5 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
