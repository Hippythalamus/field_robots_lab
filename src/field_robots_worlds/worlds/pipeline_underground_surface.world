      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
