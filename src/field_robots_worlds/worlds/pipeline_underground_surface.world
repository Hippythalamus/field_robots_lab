        <visual name="board">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.8 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
            <diffuse>1.0 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- ANOMALY 1: Soil discoloration patch (potential gas leak hint)  -->
    <!-- Dark wet-looking patch on the ground at x=-12, y=0             -->
    <!-- ============================================================== -->
    <model name="anomaly_soil_patch">
      <static>true</static>
      <pose>-12 0 0.01 0 0 0</pose>
      <link name="link">
