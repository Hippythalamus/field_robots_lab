              <name>PipelineWorlds/WetSoil</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- ANOMALY 2: Ground subsidence (depression in soil)              -->
    <!-- Slightly recessed disc at x=5, y=-0.5                          -->
    <!-- ============================================================== -->
    <model name="anomaly_subsidence">
      <static>true</static>
      <pose>5 -0.5 -0.05 0 0 0</pose>
      <link name="link">
