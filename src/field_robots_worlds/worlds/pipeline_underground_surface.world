<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pipeline_underground_surface">

    <!-- Physics -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Outdoor scene -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.65 0.75 0.85 1</background>
      <shadows>0</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.4 -1.0</direction>
    </light>

    <!-- ============================================================== -->
    <!-- Ground plane: bare earth color (typical pipeline corridor)     -->
    <!-- ============================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 40</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/scripts/pipeline_materials.material</uri>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/textures</uri>
              <name>PipelineWorlds/DirtGround</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

