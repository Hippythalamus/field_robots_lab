    <!-- Pipeline marker sign (vertical board near corridor start)      -->
    <!-- ============================================================== -->
    <model name="warning_sign">
      <static>true</static>
      <pose>-25 4 1.5 0 0 0</pose>
      <link name="link">
        <visual name="post">
