<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tank_farm">

    <!-- Physics -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>15 0 30 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1.0</direction>
    </light>

    <!-- Fill light -->
    <light name="fill" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>-10 0 20 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.5 -0.3 -1.0</direction>
    </light>

    <!-- =================================================================== -->
    <!-- GROUND PLANE — 70m × 45m to accommodate larger tanks and patrol      -->
    <!-- =================================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 45</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 45</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/scripts/pipeline_materials.material</uri>
              <uri>file:///home/evg/field_robots_lab/install/field_robots_worlds/share/field_robots_worlds/materials/textures</uri>
              <name>PipelineWorlds/DirtGround</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

